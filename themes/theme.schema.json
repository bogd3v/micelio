{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "contract": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "The folder name."
    },
    "name": {
      "type": "string"
    },
    "modes": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[\\w-]+$",
            "description": "Goes into data-theme, CSS selectors and the micelio-theme storage key."
          },
          "scheme": {
            "type": "string",
            "enum": [
              "dark",
              "light"
            ],
            "description": "Lightness of the mode; core CSS selects on data-scheme."
          },
          "name": {
            "description": "Label of the mode in the switch.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "scheme"
        ]
      },
      "description": "The first mode is the theme default."
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "pattern": "^[\\w.-]+\\.woff2$",
            "description": "A woff2 file in the theme's fonts/ folder."
          },
          "preload": {
            "type": "boolean"
          }
        },
        "required": [
          "family",
          "file"
        ]
      }
    },
    "images": {
      "description": "Files of images/ the core uses as defaults; they are served at /theme/images/.",
      "type": "object",
      "properties": {
        "favicon": {
          "description": "Default favicon, when the site settings have none.",
          "type": "string",
          "pattern": "^[\\w.-]+\\.(png|jpe?g|webp|avif|gif|svg)$"
        },
        "ogImage": {
          "description": "Default share image of pages that have no cover.",
          "type": "string",
          "pattern": "^[\\w.-]+\\.(png|jpe?g|webp|avif|gif|svg)$"
        },
        "profile": {
          "description": "Picture of the about profile block when the content has no photo.",
          "type": "string",
          "pattern": "^[\\w.-]+\\.(png|jpe?g|webp|avif|gif|svg)$"
        }
      },
      "additionalProperties": false
    },
    "layout": {
      "description": "Variant of each region; an omitted region uses the core default (the first variant).",
      "type": "object",
      "properties": {
        "header": {
          "type": "string",
          "enum": [
            "bar",
            "centered"
          ]
        },
        "home": {
          "type": "string",
          "enum": [
            "showcase",
            "index"
          ]
        },
        "postList": {
          "type": "string",
          "enum": [
            "grid",
            "list"
          ]
        },
        "article": {
          "type": "string",
          "enum": [
            "aside",
            "centered"
          ]
        },
        "footer": {
          "type": "string",
          "enum": [
            "columns",
            "minimal"
          ]
        }
      },
      "additionalProperties": false
    },
    "slots": {
      "description": "Options of the closed list of slots; the component itself is slots/<Name>.vue.",
      "type": "object",
      "properties": {
        "ThemeMark": {
          "type": "object",
          "properties": {
            "island": {
              "description": "True when the slot needs JavaScript (ADR 0005, section 12).",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "ThemeHero": {
          "type": "object",
          "properties": {
            "island": {
              "description": "True when the slot needs JavaScript (ADR 0005, section 12).",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "ThemeDivider": {
          "type": "object",
          "properties": {
            "island": {
              "description": "True when the slot needs JavaScript (ADR 0005, section 12).",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "ThemeEmptyState": {
          "type": "object",
          "properties": {
            "island": {
              "description": "True when the slot needs JavaScript (ADR 0005, section 12).",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "ThemeIllustration": {
          "type": "object",
          "properties": {
            "island": {
              "description": "True when the slot needs JavaScript (ADR 0005, section 12).",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "ThemeProgressMarker": {
          "type": "object",
          "properties": {
            "island": {
              "description": "True when the slot needs JavaScript (ADR 0005, section 12).",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "ThemeSupportArt": {
          "type": "object",
          "properties": {
            "island": {
              "description": "True when the slot needs JavaScript (ADR 0005, section 12).",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "color": {
      "type": "object",
      "properties": {
        "note": {
          "type": "string"
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[\\w-]+$"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                ],
                "description": "A value, or one value per mode id (color and shadow groups only). `{name}` references another token."
              },
              "at": {
                "description": "Values from a min-width on (single-value tokens only).",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "usage": {
                "type": "string"
              },
              "contrast": {
                "description": "Extra contrast assertions, checked by `npm run theme:check` on top of the contract's rule table.",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "on": {
                      "type": "string",
                      "pattern": "^[\\w-]+$",
                      "description": "A color role or token this one sits on."
                    },
                    "min": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 21,
                      "description": "Minimum WCAG contrast ratio on it, in every mode."
                    }
                  },
                  "required": [
                    "on",
                    "min"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "name",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "tokens"
      ],
      "additionalProperties": false
    },

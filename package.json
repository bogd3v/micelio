{
  "name": "micelio",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "theme:schema": "jiti scripts/theme-schema.ts",
    "theme:reference": "jiti scripts/theme-reference.ts",
    "theme:check": "jiti scripts/theme-check.ts",
    "theme:new": "jiti scripts/theme-new.ts",
    "tokens": "node scripts/build-tokens.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxi typecheck",
    "lint": "eslint . && npm run lint:primitives && npm run lint:classes && npm run lint:schema && npm run lint:reference && npm run lint:licenses",
    "lint:licenses": "node scripts/check-licenses.mjs",
    "lint:schema": "jiti scripts/theme-schema.ts --check",
    "lint:reference": "jiti scripts/theme-reference.ts --check",
    "lint:classes": "node scripts/check-classes.mjs",
    "lint:primitives": "node scripts/check-primitives.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run -c vitest.config.integration.ts",
    "test:e2e": "playwright test && playwright test -c playwright.modules-off.config.ts && playwright test -c playwright.theme-overrides.config.ts && playwright test -c playwright.home-page.config.ts",
    "test:theme": "playwright test -c playwright.theme.config.ts",
    "test:theme:update": "playwright test -c playwright.theme.config.ts --update-snapshots=changed",
    "perf": "node scripts/perf/measure.mjs --serve"
  },
  "dependencies": {
    "@nuxt/image": "^2.0.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@vueuse/nuxt": "^14.2.1",
    "marked": "^18.0.14",
    "mermaid": "^12.0.0",
    "nodemailer": "^10.0.13",
    "nuxt": "^4.5.2",
    "qs": "^6.15.1",
    "sanitize-html": "^2.17.5",
    "vue": "^3.5.43",
    "vue-router": "^5.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@intlify/message-compiler": "^11.4.12",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@playwright/test": "^1.63.0",
    "@types/marked": "^5.0.2",
    "@types/node": "^22.20.5",
    "@types/qs": "^6.15.1",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/compiler-sfc": "^3.5.43",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "jiti": "^2.7.0",
    "lighthouse": "^13.5.0",
    "lightningcss": "^1.33.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "lodash-es": "^4.18.1",
    "simple-git": "^4.0.2"
  }
}

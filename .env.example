# Nuxt reads these at runtime: only NUXT_* names override runtimeConfig.
# Plain names like STRAPI_API_TOKEN are ignored by the built server.

# Strapi CMS Configuration
# In production this and NUXT_UMAMI_URL must be https, or http to a private host (localhost, a private address, a service name like http://strapi:1337); anything else stops the boot (ADR 0011).
NUXT_PUBLIC_STRAPI_URL=http://localhost:1337
NUXT_STRAPI_API_TOKEN=your_api_token_here

# Per-visitor rate limits in the CMS (docs/security.md, "Client IP and rate limits").
# Same value as RATE_LIMIT_FORWARDER_SECRET in the CMS, at least 32 characters (openssl rand -base64 32). Empty: off.
NUXT_STRAPI_FORWARDER_SECRET=
# How far X-Forwarded-For is trusted: private (default), a number of proxies, CIDR list or false.
NUXT_TRUST_PROXY=private
# Header that carries the proxy chain (default X-Forwarded-For).
NUXT_PROXY_IP_HEADER=

# Newsletter email over SMTP. Use your provider's relay; some hosts block outbound ports 25 and 465, so 587 or 2525 may be needed.
NUXT_SMTP_HOST=smtp.example.com
NUXT_SMTP_PORT=587
NUXT_SMTP_USER=your_smtp_login
NUXT_SMTP_PASS=your_smtp_password
NUXT_NEWSLETTER_FROM="Example <no-reply@example.com>"
NUXT_PUBLIC_SITE_URL=https://example.com

# Site-specific values (no defaults in nuxt.config.ts).
# Host of the Strapi uploads, allowed in the image CSP: https://media.example.com
NUXT_MEDIA_URL=
# Fediverse account: @site@cms.example.com
NUXT_PUBLIC_FEDIVERSE_HANDLE=
# https://cms.example.com/fediverse/user/site
NUXT_PUBLIC_FEDIVERSE_ACTOR_URL=
# https://cms.example.com/fediverse/articles
NUXT_PUBLIC_FEDIVERSE_ARTICLES_URL=

# Source code link in the footer (AGPL section 13): point it at your fork if you run a modified Micelio
# NUXT_PUBLIC_SOURCE_URL=https://github.com/bogd3v/micelio

# Umami analytics (optional)
NUXT_PUBLIC_UMAMI_WEBSITE_ID=
NUXT_UMAMI_URL=

# Site mode, chosen at build time (ADR 0006): dynamic (default), static or landing.
# static and landing are prerendered: no comments, accounts, drafts or fediverse.
# NUXT_PUBLIC_SITE_MODE=dynamic
# Newsletter in static modes: a plain form POST to your provider, and its email field name
# NUXT_PUBLIC_NEWSLETTER_FORM_ACTION=https://buttondown.com/api/emails/embed-subscribe/your-newsletter
# NUXT_PUBLIC_NEWSLETTER_FORM_FIELD=email

# Theme registry (build time, for npm run theme:add / theme:pull / theme:outdated): host[:port]/path of the OCI registry that
# holds the themes. The scheme is always https (http only for a loopback registry). Default: the official registry.
# MICELIO_THEME_REGISTRY=ghcr.io/bogd3v/micelio-themes
# Directory of the cache of pulled theme packages, by digest. Default: ~/.cache/micelio (or $XDG_CACHE_HOME/micelio).
# MICELIO_CACHE_DIR=

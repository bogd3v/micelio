# Nuxt reads these at runtime: only NUXT_* names override runtimeConfig.
# Plain names like STRAPI_API_TOKEN are ignored by the built server.

# Strapi CMS Configuration
NUXT_PUBLIC_STRAPI_URL=http://localhost:1337
NUXT_STRAPI_API_TOKEN=your_api_token_here

# Newsletter email via Brevo's SMTP relay (bogdev-infra README, section 6).
# Port 2525 because Hetzner blocks outbound 25 and 465. NUXT_SMTP_PASS is the Brevo SMTP key.
NUXT_SMTP_HOST=smtp-relay.brevo.com
NUXT_SMTP_PORT=2525
NUXT_SMTP_USER=your_brevo_smtp_login
NUXT_SMTP_PASS=your_brevo_smtp_key
NUXT_NEWSLETTER_FROM="BogDev <no-reply@bogdev.com.co>"
NUXT_PUBLIC_SITE_URL=https://yourdomain.com

# Site-specific values (no defaults in nuxt.config.ts). BogDev's are in the comments.
# Host of the Strapi uploads, allowed in the image CSP: https://resources.bogdev.com.co
NUXT_MEDIA_URL=
# Fediverse account: @bogdev@api.bogdev.com.co
NUXT_PUBLIC_FEDIVERSE_HANDLE=
# https://api.bogdev.com.co/fediverse/user/devbog
NUXT_PUBLIC_FEDIVERSE_ACTOR_URL=
# https://api.bogdev.com.co/fediverse/articles
NUXT_PUBLIC_FEDIVERSE_ARTICLES_URL=

# Umami analytics (optional)
NUXT_PUBLIC_UMAMI_WEBSITE_ID=
NUXT_UMAMI_URL=
